---
import Layout from '../../layouts/Layout.astro';
import TokenCalculator from '../../components/TokenCalculator';
import QuickAnswerBox from '../../components/QuickAnswerBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getAllModels } from '../../data/models';

const models = getAllModels();

const quickAnswerHtml = `
  <p>To calculate the cost of an LLM API call: <strong>Cost = (Input Tokens &times; Input Rate per 1M + Output Tokens &times; Output Rate per 1M) / 1,000,000</strong>.</p>
  <p class="mt-2">For example, a prompt with 2,000 input tokens and 1,000 output tokens on <strong>OpenAI GPT-4o</strong> ($2.50 in / $10.00 out) costs <strong>$0.015 per request</strong> ($225/mo at 500 requests/day). Enabling Prompt Caching reduces input costs by 50% ($1.25/1M), bringing the monthly bill down to <strong>$187.50</strong>.</p>
`;

const faqItems = [
  {
    q: 'How do you calculate OpenAI API token pricing?',
    a: 'OpenAI charges per 1M tokens. GPT-4o is $2.50/1M input ($1.25/1M cached) and $10.00/1M output. GPT-4o mini is $0.15/1M input and $0.60/1M output. Output tokens cost 4x more because autoregressive generation requires recurrent compute passes.',
  },
  {
    q: 'How many words is 1,000 tokens?',
    a: 'In English, 1,000 tokens is approximately 750 words (or about 1.33 tokens per word). In code, 1,000 tokens is roughly 50 to 80 lines of code. For Chinese and non-Latin scripts, 1 token roughly corresponds to 0.6 to 1.2 characters.',
  },
  {
    q: 'What is the cheapest way to run LLMs for high-volume apps?',
    a: 'For high volumes (>10M tokens/day), utilize smaller models (GPT-4o mini or DeepSeek V3) which cost less than $0.15/1M tokens, maximize prompt caching (reduces input cost up to 90%), or route through discounted aggregators like DeepInfra or Together AI.',
  },
];
---

<Layout
  title="AI Token Cost Calculator 2026 — OpenAI, Claude & DeepSeek API Calculator"
  description="Accurate AI token pricing calculator. Calculate OpenAI API costs, Claude 3.5 Sonnet, and DeepSeek V3 token budgets with Prompt Caching discounts and monthly projections."
  faqItems={faqItems}
  models={models}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>&rsaquo;</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">Token Cost Calculator</span>
    </nav>

    <div class="text-center sm:text-left mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        AI Token Cost Calculator
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
        Estimate your monthly LLM API expenses across OpenAI, Anthropic, DeepSeek, and Google Gemini.
      </p>
    </div>

    <!-- Featured Snippet Direct Answer Box -->
    <QuickAnswerBox
      question="How is AI API token cost calculated?"
      answerHtml={quickAnswerHtml}
      badge="FORMULA &amp; CALCULATION"
    />

    <!-- Interactive Calculator -->
    <div class="mt-8">
      <TokenCalculator client:load models={models} initialModelId="gpt-4o" />
    </div>

    <!-- Step by Step Guide & Formula -->
    <div class="mt-16 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">
        How Token Billing Works
      </h2>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 dark:text-slate-300">
        <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/60">
          <strong class="text-sm font-bold text-slate-900 dark:text-white block mb-1">1. Input Tokens</strong>
          Your prompt, context, system instructions, and chat history. Billed per million tokens. Cached prompts receive 50% to 90% automatic discounts.
        </div>
        <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/60">
          <strong class="text-sm font-bold text-slate-900 dark:text-white block mb-1">2. Output Tokens</strong>
          The text generated by the AI model. Typically priced 3x to 5x higher than input tokens due to sequential GPU compute overhead.
        </div>
        <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/60">
          <strong class="text-sm font-bold text-slate-900 dark:text-white block mb-1">3. Aggregator Savings</strong>
          Hosting aggregators (OpenRouter, DeepInfra) aggregate volume discounts across GPUs, passing savings of 10%–40% on open-weights models.
        </div>
      </div>
    </div>

    <!-- PAA FAQ -->
    <FaqSection items={faqItems} />
  </div>
</Layout>
