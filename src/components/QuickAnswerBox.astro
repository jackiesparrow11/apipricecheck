---
interface Props {
  question: string;
  answerHtml: string;
  badge?: string;
}

const { question, answerHtml, badge = 'QUICK ANSWER' } = Astro.props;
---

<div class="my-6 rounded-2xl border border-teal-200 bg-teal-50/70 p-5 dark:border-teal-900/60 dark:bg-teal-950/30">
  <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-teal-800 dark:text-teal-300">
    <span class="flex h-2 w-2 rounded-full bg-teal-500 animate-pulse"></span>
    <span>{badge}</span>
  </div>
  <h2 class="mt-1 text-base font-bold text-slate-900 dark:text-white">
    {question}
  </h2>
  <div class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-200 prose prose-sm dark:prose-invert max-w-none" set:html={answerHtml} />
</div>
