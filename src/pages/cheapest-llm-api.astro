---
import Layout from '../layouts/Layout.astro';
import PricingTable from '../components/PricingTable';
import QuickAnswerBox from '../components/QuickAnswerBox.astro';
import FaqSection from '../components/FaqSection.astro';
import { getCheapestModels, getAllModels } from '../data/models';

const allModels = getAllModels();
const cheapestModels = getCheapestModels(8);

const quickAnswerHtml = `
  <p>The cheapest LLM APIs in 2026 are:</p>
  <ul class="list-disc pl-5 mt-2 space-y-1">
    <li><strong>Llama 3.1 8B Instruct</strong>: $0.02 / 1M input &middot; $0.05 / 1M output (via DeepInfra)</li>
    <li><strong>Gemini 2.0 Flash</strong>: $0.10 / 1M input &middot; $0.40 / 1M output (via Google)</li>
    <li><strong>Llama 3.3 70B Instruct</strong>: $0.12 / 1M input &middot; $0.30 / 1M output (via DeepInfra / OpenRouter)</li>
    <li><strong>DeepSeek V3</strong>: $0.14 / 1M input &middot; $0.28 / 1M output (Flagship intelligence)</li>
    <li><strong>GPT-4o mini</strong>: $0.15 / 1M input &middot; $0.60 / 1M output (via OpenAI)</li>
  </ul>
`;

const faqItems = [
  {
    q: 'What is the absolute cheapest AI API for production in 2026?',
    a: 'Llama 3.1 8B Instruct hosted on DeepInfra is currently the cheapest at $0.02 per million input tokens. For complex reasoning and coding tasks, DeepSeek V3 is the cheapest flagship-tier model at $0.14 per 1M tokens.',
  },
  {
    q: 'Are cheap LLM APIs reliable for business production?',
    a: 'Yes. Models like GPT-4o mini, DeepSeek V3, and Gemini 2.0 Flash offer 99.9%+ SLA through enterprise providers and aggregators while offering quality scores that outperform GPT-4 from 2023 at less than 1/30th the cost.',
  },
  {
    q: 'How can I get free LLM API credits?',
    a: 'Google AI Studio currently offers free tier access to Gemini 1.5 Flash and Gemini 2.0 Flash up to rate limits (15 RPM). OpenRouter also flags community-donated free endpoints tagged with :free.',
  },
];
---

<Layout
  title="Cheapest LLM APIs (2026) — Lowest Cost AI Models Ranked"
  description="Ranked directory of the cheapest LLM APIs in 2026. Compare lowest cost models including DeepSeek V3 ($0.14/1M), Llama 3.1 8B ($0.02/1M), GPT-4o mini, and free tiers."
  faqItems={faqItems}
  models={allModels}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>&rsaquo;</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">Cheapest LLM APIs</span>
    </nav>

    <div class="mb-8">
      <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        Budget &amp; High-Volume Guide
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Cheapest LLM APIs Ranked (2026)
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
        Find the most affordable language models for production agents, batch pipelines, and high-volume workloads.
      </p>
    </div>

    <!-- Quick Direct Answer Snippet -->
    <QuickAnswerBox
      question="What is the cheapest LLM API?"
      answerHtml={quickAnswerHtml}
      badge="LOWEST COST RANKING"
    />

    <!-- Highlight Cards for Top 3 Budget Leaders -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {cheapestModels.slice(0, 3).map((m, idx) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 relative overflow-hidden">
          <div class="absolute -top-2 -right-2 flex h-8 w-8 items-center justify-center rounded-bl-xl bg-emerald-500 text-xs font-bold text-white">
            #{idx + 1}
          </div>
          <span class="text-[11px] font-semibold uppercase text-slate-400">{m.providerName}</span>
          <h2 class="mt-1 text-lg font-bold text-slate-900 dark:text-white">{m.name}</h2>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-mono text-2xl font-black text-emerald-600 dark:text-emerald-400">
              ${m.officialPricing.inputPerM.toFixed(m.officialPricing.inputPerM < 0.1 ? 3 : 2)}
            </span>
            <span class="text-xs text-slate-400">/ 1M input</span>
          </div>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
            {m.description}
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="font-mono text-slate-400">Output: ${m.officialPricing.outputPerM.toFixed(2)}/1M</span>
            <span class="font-mono text-slate-400">{(m.contextWindow / 1000).toFixed(0)}k ctx</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Full Filterable Comparison Table -->
    <div class="mt-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        All Budget &amp; Production Models
      </h2>
      <PricingTable client:load models={allModels} />
    </div>

    <FaqSection items={faqItems} />
  </div>
</Layout>
