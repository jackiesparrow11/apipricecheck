---
import Layout from '../layouts/Layout.astro';
import TokenCalculator from '../components/TokenCalculator';
import PricingTable from '../components/PricingTable';
import FaqSection from '../components/FaqSection.astro';
import { getAllModels, getTopHomepageModels } from '../data/models';

const allModels = getAllModels();
const topModels = getTopHomepageModels(20);
const todayDate = new Date().toISOString().split('T')[0];

const cheapestModel = [...topModels].sort((a, b) => a.officialPricing.inputPerM - b.officialPricing.inputPerM)[0] || topModels[0];
const topCodingModel = topModels.find((m) => m.creator === 'anthropic') || topModels[1];
const topReasoningModel = topModels.find((m) => m.creator === 'openai') || topModels[0];

const faqItems = [
  {
    q: 'What is the cheapest LLM API currently available in 2026?',
    a: `The lowest price per token among frontier models is ${cheapestModel?.name} ($${cheapestModel?.officialPricing.inputPerM.toFixed(2)}/1M input) followed by lightweight open-weights models ($0.02/1M input via OpenRouter).`,
  },
  {
    q: 'How does official provider pricing compare with aggregators like OpenRouter?',
    a: 'While proprietary models generally match official rates on aggregators, open-weights models (DeepSeek, Llama, Qwen) frequently feature 15% to 40% lower token pricing on hosting aggregators (such as DeepInfra, Together AI, or Fireworks) compared to hyperscalers.',
  },
  {
    q: 'How does Prompt Caching impact my actual AI API bill?',
    a: 'Prompt Caching allows providers to store repeated context in memory. Cache hits reduce input costs by 50% to 90% across OpenAI, Anthropic, Google Gemini, and DeepSeek endpoints.',
  },
  {
    q: 'How does this token cost calculator compute monthly estimates?',
    a: 'Our calculator uses the exact formula: (Input Tokens × (1 - Cache Rate) × P_in + Input Tokens × Cache Rate × P_cache + Output Tokens × P_out) / 1,000,000 × Daily Calls × 30. We evaluate both official direct endpoints and best-available aggregator endpoints.',
  },
  {
    q: 'Are the token prices updated daily?',
    a: 'Yes. Our automated ingestion pipeline checks official documentation and OpenRouter API endpoints daily. Price reductions or newly released models are synchronized within hours.',
  },
  {
    q: 'Can I download the raw AI pricing dataset?',
    a: 'Yes, we provide an open, standardized JSON endpoint at /api/pricing.json with CC-BY 4.0 license for developer and research use.',
  },
];
---

<Layout
  title="AI API Pricing Calculator — Compare 300+ LLM Token Rates"
  description="Compare official & aggregator AI API token rates for 300+ models. Calculate monthly budgets for GPT-6.1, Claude 5.5, Gemini 4, DeepSeek V4, and Grok 4.7."
  faqItems={faqItems}
  models={topModels}
  isDataset={true}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 px-4 pt-16 pb-20 text-white sm:px-6 lg:px-8">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(20,184,166,0.18),rgba(255,255,255,0))]"></div>
    <div class="relative mx-auto max-w-5xl text-center">
      <!-- Live Freshness Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-500/10 px-3.5 py-1 text-xs font-semibold text-teal-300 backdrop-blur-sm">
        <span class="flex h-2 w-2 rounded-full bg-teal-400 animate-pulse"></span>
        <span>Daily Verified · Updated {todayDate}</span>
      </div>

      <h1 class="mt-6 text-3xl font-black tracking-tight sm:text-5xl lg:text-6xl text-white">
        AI API Pricing Calculator <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-teal-400 via-cyan-300 to-emerald-400 bg-clip-text text-transparent">
          Compare 300+ LLM Token Rates
        </span>
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-slate-300">
        Compare official direct rates against verified aggregators (OpenRouter, DeepInfra, Together AI).
        Simulate token budgets with Prompt Caching discounts across 300+ frontier and open-weights models.
      </p>

      <!-- Quick Metrics Pills (Data-Driven from Top Models) -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-xs">
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 backdrop-blur-sm">
          <span class="text-slate-400">Cheapest Frontier: </span>
          <strong class="text-teal-300">{cheapestModel.name} (${cheapestModel.officialPricing.inputPerM.toFixed(2)}/1M)</strong>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 backdrop-blur-sm">
          <span class="text-slate-400">Coding Standard: </span>
          <strong class="text-cyan-300">{topCodingModel.name} (${topCodingModel.officialPricing.inputPerM.toFixed(2)}/1M)</strong>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 backdrop-blur-sm">
          <span class="text-slate-400">Frontier Reasoning: </span>
          <strong class="text-emerald-300">{topReasoningModel.name} (${topReasoningModel.officialPricing.inputPerM.toFixed(2)}/1M)</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Embedded Front-Loaded Calculator (P0 SEO Retention Driver) -->
  <section class="relative -mt-10 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <TokenCalculator client:load models={topModels} initialModelId={topModels[0]?.id || 'gpt-6.1-sol'} embedded={true} />
    </div>
  </section>

  <!-- Section 2: Comprehensive Comparison Matrix (Official vs Aggregators) -->
  <section class="mt-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Real-Time Directory</span>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            Live AI Model Token Rates
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Official list pricing vs. lowest available aggregator rate (OpenRouter &amp; inference clouds).
          </p>
        </div>

        <a
          href="/cheapest-llm-api/"
          class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
        >
          View Lowest Cost Models &rarr;
        </a>
      </div>

      <PricingTable client:load models={topModels} totalModelsCount={allModels.length} hasMoreModels={true} />
    </div>
  </section>

  <!-- Section 2.5: Subscriptions Hub Discovery Banner -->
  <section class="mt-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-900 via-slate-800 to-brand-950 p-6 sm:p-8 text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="rounded-full bg-brand-500/20 border border-brand-400/30 px-3 py-1 text-xs font-semibold text-brand-300">
            Monthly Plans vs. Metered API
          </span>
          <h3 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-white">
            Looking for Flat-Rate Monthly Subscriptions?
          </h3>
          <p class="mt-1.5 text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            Compare ChatGPT Plus ($20), Claude Pro ($20), Google AI Pro ($19.99), Cursor Pro, Kimi VIP, GLM Coding, and DeepSeek. Review message caps, context windows, and find out whether a subscription or API is cheaper for your workload.
          </p>
        </div>
        <a
          href="/subscriptions/"
          class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-xs font-bold text-white hover:bg-brand-400 shadow-lg shadow-brand-500/25 transition"
        >
          <span>Compare 30+ Subscriptions</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3: FAQ Section (PAA Snippets) -->
  <section class="px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <FaqSection items={faqItems} />
    </div>
  </section>
</Layout>
