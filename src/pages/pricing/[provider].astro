---
import Layout from '../../layouts/Layout.astro';
import PricingTable from '../../components/PricingTable';
import TokenCalculator from '../../components/TokenCalculator';
import QuickAnswerBox from '../../components/QuickAnswerBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getProvidersList, getModelsByProvider, getAllModels } from '../../data/models';
import type { ProviderInfo, ModelRecord } from '../../data/types';

export function getStaticPaths() {
  const providers = getProvidersList();
  return providers.map((provider) => ({
    params: { provider: provider.id },
    props: { provider },
  }));
}

interface Props {
  provider: ProviderInfo;
}

const { provider } = Astro.props;
const providerModels = getModelsByProvider(provider.id);
const allModels = getAllModels();

const flagshipModel = providerModels.find((m) => m.isFlagship) || providerModels[0];
const cheapestModel = [...providerModels].sort((a, b) => a.officialPricing.inputPerM - b.officialPricing.inputPerM)[0];

const quickAnswerHtml = `
  <p><strong>How much does ${provider.name} API cost?</strong></p>
  <p class="mt-2">
    ${provider.name} model rates start at <strong>$${cheapestModel.officialPricing.inputPerM.toFixed(cheapestModel.officialPricing.inputPerM < 0.1 ? 3 : 2)}</strong> per 1M input tokens (${cheapestModel.name}) and up to <strong>$${flagshipModel.officialPricing.outputPerM.toFixed(2)}</strong> per 1M output tokens for flagship ${flagshipModel.name}.
    ${flagshipModel.officialPricing.cachedInputPerM > 0 ? `Prompt Caching reduces input costs down to <strong>$${flagshipModel.officialPricing.cachedInputPerM.toFixed(flagshipModel.officialPricing.cachedInputPerM < 0.05 ? 3 : 2)}/1M</strong> on cache hits.` : ''}
  </p>
`;

const faqItems = [
  {
    q: `How much does ${provider.name} API cost per token?`,
    a: `${provider.name} charges on a per-million token basis. For ${flagshipModel.name}, input tokens cost $${flagshipModel.officialPricing.inputPerM.toFixed(2)}/1M and output tokens cost $${flagshipModel.officialPricing.outputPerM.toFixed(2)}/1M.`,
  },
  {
    q: `Does ${provider.name} offer Prompt Caching discounts?`,
    a: flagshipModel.officialPricing.cachedInputPerM < flagshipModel.officialPricing.inputPerM
      ? `Yes. ${provider.name} supports automated or explicit prompt caching, reducing input costs on cache hits down to $${flagshipModel.officialPricing.cachedInputPerM.toFixed(3)}/1M.`
      : `Prompt caching depends on the specific endpoint architecture. Please refer to the official documentation.`,
  },
  {
    q: `Can I access ${provider.name} models via OpenRouter or other aggregators?`,
    a: `Yes, most ${provider.name} models are mirrored or directly routed through aggregators like OpenRouter, DeepInfra, and Together AI, often offering pay-as-you-go billing without minimum monthly commitments.`,
  },
];
---

<Layout
  title={`${provider.name} API Pricing 2026: Token Rates & Costs`}
  description={`Official and aggregator ${provider.name} API pricing. Compare ${providerModels.map((m) => m.name).join(', ')} token rates, Prompt Caching discounts, and calculate monthly budgets.`}
  faqItems={faqItems}
  models={providerModels}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>&rsaquo;</span>
      <a href="/" class="hover:text-brand-600">Providers</a>
      <span>&rsaquo;</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">{provider.name}</span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {provider.name} API Pricing (2026)
        </h1>
        <p class="mt-2 text-base text-slate-600 dark:text-slate-400">
          Official token rates, aggregator discounts, and monthly cost simulations for {provider.name}.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-mono dark:border-slate-800 dark:bg-slate-900">
          {providerModels.length} models tracked
        </span>
      </div>
    </div>

    <!-- Featured Snippet Direct Answer Box -->
    <QuickAnswerBox
      question={`How much does ${provider.name} API cost?`}
      answerHtml={quickAnswerHtml}
      badge={`${provider.name.toUpperCase()} PRICING SUMMARY`}
    />

    <!-- Dedicated Calculator Pre-selected to Flagship -->
    <div class="mt-8">
      <TokenCalculator client:load models={allModels} initialModelId={flagshipModel.id} embedded={true} />
    </div>

    <!-- Provider Models Table -->
    <div class="mt-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        {provider.name} Models Price Comparison Table
      </h2>
      <PricingTable client:load models={providerModels} filterProvider={provider.id} />
    </div>

    <FaqSection items={faqItems} />
  </div>
</Layout>
