---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: FaqItem[];
}

const {
  title = 'Frequently Asked Questions',
  subtitle = 'Everything you need to know about AI token costs, caching discounts, and billing.',
  items,
} = Astro.props;
---

<section class="mt-16 border-t border-slate-200/80 pt-12 dark:border-slate-800">
  <div class="text-center">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
      {title}
    </h2>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      {subtitle}
    </p>
  </div>

  <div class="mt-8 mx-auto max-w-3xl space-y-4">
    {items.map((item, idx) => (
      <details
        class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors open:bg-slate-50/50 dark:border-slate-800 dark:bg-slate-900 dark:open:bg-slate-800/40"
        open={idx === 0}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-slate-900 dark:text-white">
          <span class="text-base">{item.q}</span>
          <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 group-open:rotate-180 dark:bg-slate-800 dark:text-slate-400 transition-transform">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
