---
import { getProvidersList } from '../data/models';
const providers = getProvidersList();
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/80 bg-slate-50/50 py-16 dark:border-slate-800 dark:bg-slate-950/60 transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:gap-12">
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-white">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-base font-bold">APIPriceCheck</span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          Independent, verified pricing comparison across official AI model APIs and verified aggregators (OpenRouter, DeepInfra, Together AI).
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Prices synced daily</span>
        </div>
      </div>

      <!-- Col 2: Major Providers -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">Providers</h3>
        <ul class="mt-3 space-y-2 text-xs text-slate-600 dark:text-slate-400">
          {providers.slice(0, 6).map((p) => (
            <li>
              <a href={`/pricing/${p.id}/`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                {p.name} Pricing
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Calculators & Tools -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">Tools & Calculators</h3>
        <ul class="mt-3 space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a href="/calculators/token-cost/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium text-brand-600 dark:text-brand-400">
              Token Cost Calculator
            </a>
          </li>
          <li>
            <a href="/cheapest-llm-api/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Cheapest LLM APIs (2026)
            </a>
          </li>
          <li>
            <a href="/api/pricing.json" target="_blank" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Download JSON Dataset
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Data & Attribution -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">Open Data</h3>
        <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          All pricing data is licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" class="underline hover:text-brand-600">CC BY 4.0</a>. Free for research and internal development with attribution.
        </p>
        <div class="mt-3">
          <a
            href="/api/pricing.json"
            target="_blank"
            class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-mono text-slate-700 hover:border-brand-500 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition"
          >
            GET /api/pricing.json
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200/60 pt-6 text-center sm:flex-row dark:border-slate-800/60">
      <p class="text-xs text-slate-400">
        &copy; {currentYear} APIPriceCheck. All rights reserved. Trademarks belong to their respective owners (OpenAI, Anthropic, Google, DeepSeek, Meta).
      </p>
      <p class="text-xs text-slate-400">
        Built for developers optimizing LLM inference budgets.
      </p>
    </div>
  </div>
</footer>
